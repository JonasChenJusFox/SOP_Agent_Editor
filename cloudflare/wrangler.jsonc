{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "admissions-editor-cloud",
  "main": "python/entry.py",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["python_workers", "python_workflows"],
  "rules": [{"type": "Text", "globs": ["**/*.json", "**/*.md", "**/*.txt", "**/*.sql"], "fallthrough": true}],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../src/admissions_editor/web", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "workflows": [{"name": "admissions-editor-cloud-review", "binding": "REVIEWS", "class_name": "ReviewWorkflow"}],
  "d1_databases": [{"binding": "DB", "database_name": "admissions-editor", "database_id": "REPLACE_WITH_DATABASE_ID", "migrations_dir": "migrations"}]
}
